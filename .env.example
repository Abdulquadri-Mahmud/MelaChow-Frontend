NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_api_key

# Product Analytics (PostHog)
# Leave NEXT_PUBLIC_POSTHOG_KEY empty or set NEXT_PUBLIC_POSTHOG_ENABLED=false to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLED=true
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_POSTHOG_SESSION_RECORDING=false
NEXT_PUBLIC_POSTHOG_DEBUG=false
