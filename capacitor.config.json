{
    "appId":  "com.melachow.customer",
    "appName":  "MelaChow",
    "webDir":  ".mobile-build/out",
    "android":  {
                    "allowMixedContent":  false
                },
    "plugins":  {
                    "CapacitorHttp":  {
                                          "enabled":  true
                                      },
                    "StatusBar":  {
                                      "overlaysWebView":  false,
                                      "backgroundColor": "#ffffff",
                                      "style":  "LIGHT"
                                  },
                    "SystemBars":  {
                                       "style":  "LIGHT",
                                       "hidden":  false,
                                       "insetsHandling":  "disable",
                                       "initialViewportFitValueHint":  "contain"
                                   }
                }
}
